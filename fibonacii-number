//fibonacii nuber
//ex:0,1,1,2,3,5,8,13,21....

//using normal function

const fabi = (n) => {
	const arr = [0,1];
  for(let i=2;i<=n;i++){
  	arr.push(arr[i-1]+arr[i-2]);
  }
  return arr[n];
}
//console.log(fabi(6));

//using recursion

 const fabonacci = (n) => {
  if(n<=1) {
  return n;
  } else {
   return fabonacci(n-1)+fabonacci(n-2);
  }
} 
console.log(fabonacci(8));

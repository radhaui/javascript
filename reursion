//Recursion 
// multiply array elements
const multiply = (arr) => {
	if(arr.length<=0) {
  	return 1;
  } else
  {
  	return arr[arr.length-1] * multiply(arr.slice(0,arr.length-1));
  }
}

console.log(multiply([1,2,3,4,5]));

//n factorial 

const factorial = (n) => {
	if(n===1){
  	return 1;
  } else {
  	return n * factorial(n-1);
  }
}

console.log(factorial(5));

